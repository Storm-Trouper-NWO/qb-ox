  - action: waste_time # prevent github throttling
    seconds: 10

  - action: download_github
    dest: ./resources/[qb]/qb-cityhall
    ref: main
    src: https://github.com/qbcore-fivem/qb-cityhall

  - action: download_github
    dest: ./resources/[qb]/qb-pawnshop
